{
    "name": "microinvest-mcp",
    "version": "1.0.0",
    "description": "MCP server for Microinvest Warehouse Pro, Open, and Mobile — exposes inventory, sales, and admin data to AI agents via Model Context Protocol",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "mcp",
        "microinvest",
        "warehouse",
        "inventory",
        "pos",
        "ai",
        "model-context-protocol"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/AswathyMohan89/microinvest-mcp.git"
    },
    "engines": {
        "node": ">=18"
    },
    "bin": {
        "microinvest-mcp": "./dist/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "lint": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "latest",
        "mdb-reader": "latest",
        "mssql": "latest",
        "mysql2": "latest",
        "oracledb": "^6.10.0",
        "sqlite": "^5.1.1",
        "sqlite3": "^6.0.1",
        "zod": "latest"
    },
    "devDependencies": {
        "@types/mssql": "latest",
        "@types/node": "latest",
        "@types/oracledb": "^6.10.2",
        "prettier": "^3.0.0",
        "tsx": "latest",
        "typescript": "latest"
    }
}
